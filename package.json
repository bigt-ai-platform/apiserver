{
  "name": "apiserver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private API replay server for wallet + dai: L0/L1 chain replay, dai role proxy, IP allowlist (see selfhost.md)",
  "engines": {
